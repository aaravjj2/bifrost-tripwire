{
  "name": "bifrost-tripwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node server/start.js",
    "start": "node server/start.js --production",
    "build": "vite build",
    "build:frontend": "vite build --mode frontend",
    "test": "node --test server/policy.test.js server/remote.test.js server/origin.test.js",
    "verify": "node server/verify.js",
    "resources": "node --env-file=.local/tavily.env server/resources.js",
    "compare": "node server/compare.js"
  },
  "dependencies": {
    "three": "0.187.0",
    "vite": "8.3.8"
  }
}
